          "editorMode": "sql",
          "extrapolate": false,
          "format": "time_series",
          "interval": "",
          "query": "SELECT $timeSeries AS t,\n  sum(multiSearchAny(toString(\"level\"), ['critical','CRITICAL','Critical','fatal','FATAL','Fatal','crit','CRIT','Crit','alert','ALERT','Alert','emerg','EMERG','Emerg'])) AS critical,\n  sum(multiSearchAny(toString(\"level\"), ['error','ERROR','Error','err','ERR','Err','eror','EROR','Eror'])) AS error,\n  sum(multiSearchAny(toString(\"level\"), ['warn','WARN','Warn','warning','WARNING','Warning'])) AS warning,\n  sum(multiSearchAny(toString(\"level\"), ['info','INFO','Info','information','INFORMATION','Information','informational','INFORMATIONAL','Informational','notice','NOTICE','Notice'])) AS info,\n  sum(multiSearchAny(toString(\"level\"), ['debug','DEBUG','Debug','dbug','DBUG','Dbug'])) AS debug,\n  sum(multiSearchAny(toString(\"level\"), ['trace','TRACE','Trace'])) AS trace,\n  sum(multiSearchAny(toString(\"level\"), ['unknown','UNKNOWN','Unknown'])) AS unknown\nFROM default.test_logs_volume\nWHERE $timeFilter\nGROUP BY t ORDER BY t",
          "refId": "A",
          "table": "test_logs_volume"
        }
      ],
      "title": "Logs volume by level (server-side aggregate, same SQL Explore runs)",
      "type": "timeseries"
