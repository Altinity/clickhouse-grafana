          "table": "test_grafana",
          "dateTimeColDataType": "event_time",
          "dateTimeType": "DATETIME",
          "intervalFactor": 1,
          "round": "0s",
          "query": "SELECT service_name, count() AS c FROM $table GROUP BY service_name"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "vertamedia-clickhouse-datasource",
            "uid": "P7E099F39B84EA795"
          },
          "hide": true,
          "format": "table",
          "database": "default",
          "table": "test_grafana",
          "dateTimeColDataType": "event_time",
          "dateTimeType": "DATETIME",
          "intervalFactor": 1,
          "round": "0s",
          "query": "SELECT service_name, uniq(country) AS countries FROM $table GROUP BY service_name"
        },
        {
          "refId": "C",
          "datasource": {
            "name": "Expression",
            "type": "__expr__",
            "uid": "__expr__"
          },
          "type": "sql",
          "expression": "SELECT A.service_name AS join_service, A.c AS join_count, B.countries AS join_countries FROM A JOIN B ON A.service_name = B.service_name"
        }
      ]
    },
